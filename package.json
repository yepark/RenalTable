{
  "name": "renaltable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "신장 질환 환자와 보호자를 위한 한국어 식사 정보 서비스",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next start -p 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-db-schema.mjs",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run src/shared/infrastructure/db",
    "secrets:check": "node scripts/secret-scan.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test && npm run build",
    "ci": "npm run secrets:check && npm run check && npm run test:e2e"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "minimatch": "11.0.3"
  },
  "packageManager": "npm@11.17.0"
}
